diff --git a/hermes_cli/status_bar_sysmetrics.py b/hermes_cli/status_bar_sysmetrics.py
new file mode 100644
index 0000000000..a72affe441
--- /dev/null
+++ b/hermes_cli/status_bar_sysmetrics.py
@@ -0,0 +1,98 @@
+"""Windows system-metrics collector for the CLI status bar (CPU / RAM / GPU / DISK / NET).
+
+A single PowerShell (WMI) subprocess gathers every metric in one shot (~2-3s),
+so the render loop never blocks on per-metric subprocesses. Values are cached by
+the caller (``CLIStatusBarMixin._status_bar_sysmetrics``) with a short TTL,
+mirroring the DeepSeek balance pattern.
+
+Non-Windows platforms (and any PowerShell failure) return ``{}`` and the status
+bar renders no second line.
+"""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+from typing import Any, Dict, Optional
+
+# One subprocess, WMI-only (cheap, amortized). Writes `key=value` lines on stdout:
+#   cpu / ram / disk  -> integer percent (0-100)
+#   gpu               -> integer percent, or empty line when no GPU counter
+#   rx / tx           -> network bytes/sec (converted to Kbps by the caller)
+_PS_SCRIPT = r"""
+$ErrorActionPreference = "SilentlyContinue"
+
+$cpu = (Get-CimInstance Win32_Processor).LoadPercentage
+
+$os = Get-CimInstance Win32_OperatingSystem
+$ram = [math]::Round((($os.TotalVisibleMemorySize - $os.FreePhysicalMemory) / $os.TotalVisibleMemorySize) * 100, 0)
+
+$disk = 0
+$diskIdle = (Get-CimInstance Win32_PerfFormattedData_PerfDisk_LogicalDisk -Filter 'Name = "C:"').PercentIdleTime
+if ($null -ne $diskIdle) { $disk = 100 - $diskIdle }
+
+$gpu = ""
+$eng = Get-CimInstance Win32_PerfFormattedData_GPUPerformanceCounters_GPUEngine -ErrorAction SilentlyContinue
+if ($eng) { $gpu = [math]::Round(($eng | Measure-Object -Property UtilizationPercentage -Maximum).Maximum, 0) }
+
+$nics = Get-CimInstance Win32_PerfFormattedData_Tcpip_NetworkInterface | Where-Object { $_.Name -notmatch 'Loopback|isatap|Teredo|Bluetooth|Pseudo' }
+$rx = 0; $tx = 0
+if ($nics) {
+    $rx = [math]::Round(($nics | Measure-Object -Property BytesReceivedPerSec -Sum).Sum, 0)
+    $tx = [math]::Round(($nics | Measure-Object -Property BytesSentPerSec -Sum).Sum, 0)
+}
+
+Write-Output ("cpu=" + $cpu)
+Write-Output ("ram=" + $ram)
+Write-Output ("disk=" + $disk)
+Write-Output ("gpu=" + $gpu)
+Write-Output ("rx=" + $rx)
+Write-Output ("tx=" + $tx)
+"""
+
+
+def _parse_number(value: Optional[str]) -> Optional[float]:
+    if value is None:
+        return None
+    try:
+        return float(str(value).strip())
+    except (TypeError, ValueError):
+        return None
+
+
+def read_system_metrics(timeout: float = 10.0) -> Dict[str, Any]:
+    """Collect CPU/RAM/GPU/DISK/NET in one PowerShell call.
+
+    Returns a dict with integer percentages for ``cpu``/``ram``/``disk``, ``gpu``
+    percent or ``None`` when the counter is unavailable, and ``rx``/``tx`` in Kbps
+    (Task Manager's network unit). Any failure returns ``{}`` — never raises, so the
+    status bar degrades to an empty metrics line.
+    """
+    if sys.platform != "win32":
+        return {}
+    try:
+        proc = subprocess.run(
+            ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", _PS_SCRIPT],
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+        )
+        out = proc.stdout or ""
+    except Exception:
+        return {}
+
+    metrics: Dict[str, Any] = {}
+    for line in out.splitlines():
+        line = line.strip()
+        if "=" not in line:
+            continue
+        key, _, raw = line.partition("=")
+        key = key.strip()
+        raw = raw.strip()
+        if key in ("cpu", "ram", "disk", "gpu"):
+            metrics[key] = _parse_number(raw)
+        elif key in ("rx", "tx"):
+            num = _parse_number(raw)
+            metrics[key] = (num * 8.0 / 1000.0) if num is not None else None
+    return metrics
