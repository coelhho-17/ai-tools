+    def _status_bar_show_cost(self) -> bool:
+        """Whether ``display.show_cost`` is on. This is a top-level display flag, not a
+        ``status_bar.fields`` entry, so it survives an explicit fields list."""
+        if hasattr(self, "_status_bar_show_cost_cache"):
+            return self._status_bar_show_cost_cache
+        result = False
+        try:
+            from cli import CLI_CONFIG
+            display = CLI_CONFIG.get("display") if isinstance(CLI_CONFIG, dict) else None
+            result = bool((display or {}).get("show_cost"))
+        except Exception:
+            result = False
+        self._status_bar_show_cost_cache = result
+        return result
+
+    def _status_bar_is_deepseek(self) -> bool:
+        """True only when the active provider is DeepSeek's native endpoint — the only
+        provider whose ``/user/balance`` endpoint we know how to read."""
+        agent = getattr(self, "agent", None)
+        provider = (getattr(agent, "provider", "") or "").lower()
+        base_url = (getattr(agent, "base_url", "") or "").lower()
+        return provider == "deepseek" or "api.deepseek.com" in base_url
+
+    def _status_bar_balance(self) -> str:
+        """DeepSeek account balance (remaining, USD), cached ~5 min and fetched in a
+        background thread so the render loop never blocks. Returns "" when unavailable."""
+        if not self._status_bar_is_deepseek():
+            return ""
+        cache = getattr(self, "_status_bar_balance_cache", None)
+        now = time.monotonic()
+        if cache is not None and (now - cache[0]) < _BALANCE_TTL_SECONDS:
+            return cache[1]
+        if not getattr(self, "_status_bar_balance_fetching", False):
+            self._status_bar_balance_fetching = True
+            try:
+                threading.Thread(target=self._status_bar_balance_fetch, daemon=True).start()
+            except Exception:
+                self._status_bar_balance_fetching = False
+        return cache[1] if cache is not None else ""
+
+    def _status_bar_balance_key(self) -> str:
+        """Resolve the DeepSeek API key for the balance fetch, tolerating the credential-pool
+        architecture introduced post-update: ``agent.api_key`` may be empty or a callable token
+        provider, while the real key lives in ``agent._credential_pool``."""
+        agent = getattr(self, "agent", None)
+        if agent is None:
+            return ""
+        key = getattr(agent, "api_key", "")
+        if isinstance(key, str) and key.strip():
+            return key.strip()
+        pool = getattr(agent, "_credential_pool", None)
+        if pool is not None:
+            try:
+                for entry in pool.entries():
+                    rk = getattr(entry, "runtime_api_key", None)
+                    if isinstance(rk, str) and rk.strip():
+                        return rk.strip()
+            except Exception:
+                pass
+        # Final fallback: the DeepSeek key lives in the profile .env (env-seeded pool rows
+        # persist only a fingerprint, so re-hydration depends on this same source). Read it
+        # directly — the standalone deepseek-balance script uses exactly this path.
+        try:
+            from agent.credential_pool import get_env_prefer_dotenv
+            env_key = get_env_prefer_dotenv("DEEPSEEK_API_KEY")
+            if isinstance(env_key, str) and env_key.strip():
+                return env_key.strip()
+        except Exception:
+            pass
+        return ""
+
+    def _status_bar_balance_fetch(self) -> None:
+        """Background fetch of the DeepSeek balance; never raises. Failure caches an empty
+        value too, so a dead network doesn't retry on every render (retries after the TTL)."""
+        import logging
+        _log = logging.getLogger(__name__)
+        value = ""
+        key = ""
+        err = ""
+        try:
+            key = self._status_bar_balance_key()
+            value = self._status_bar_balance_usd(key) if key else ""
+        except Exception as _ex:  # noqa: BLE001 - deliberate fail-open
+            err = f"{type(_ex).__name__}: {_ex}"
+            value = ""
+        finally:
+            try:
+                self._status_bar_balance_cache = (time.monotonic(), value)
+            finally:
+                self._status_bar_balance_fetching = False
+            # Mirror the sysmetrics fetch: wake the render loop so the fresh balance paints
+            # even while the prompt is idle (the idle spinner never repaints on a timer).
+            app = getattr(self, "_app", None)
+            if app is not None:
+                try:
+                    app.invalidate()
+                except Exception:
+                    pass
+        _log.info(
+            "deepseek balance fetch: key=%s value=%s%s",
+            f"set(len={len(key)})" if key else "empty",
+            value or "-",
+            f" err={err}" if err else "",
+        )
+
+    def _status_bar_balance_usd(self, api_key: str) -> str:
+        """GET /user/balance for the key, returning a compact ``$X.XX`` label or ""."""
+        import json
+        import urllib.request
+        req = urllib.request.Request(
+            "https://api.deepseek.com/user/balance",
+            headers={"Authorization": "Bearer " + api_key, "Accept": "application/json"},
+        )
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            data = json.loads(resp.read().decode("utf-8"))
+        if not data.get("is_available"):
+            return ""
+        for info in data.get("balance_infos", []):
+            try:
+                total = float(info.get("total_balance", 0.0))
+            except (TypeError, ValueError):
+                continue
+            return f"${total:.2f}"
+        return ""
+
