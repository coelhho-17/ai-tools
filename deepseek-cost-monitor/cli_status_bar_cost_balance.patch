+    def _status_bar_show_cost(self) -> bool:
+        """Whether ``display.show_cost`` is on. This is a top-level display flag, not a
+        ``status_bar.fields`` entry, so it survives an explicit fields list."""
+        if hasattr(self, "_status_bar_show_cost_cache"):
+            return self._status_bar_show_cost_cache
+        result = False
+        try:
+            from cli import CLI_CONFIG
+            display = CLI_CONFIG.get("display") if isinstance(CLI_CONFIG, dict) else None
+            result = bool((display or {}).get("show_cost"))
+        except Exception:
+            result = False
+        self._status_bar_show_cost_cache = result
+        return result
+
+    def _status_bar_is_deepseek(self) -> bool:
+        """True only when the active provider is DeepSeek's native endpoint — the only
+        provider whose ``/user/balance`` endpoint we know how to read."""
+        agent = getattr(self, "agent", None)
+        provider = (getattr(agent, "provider", "") or "").lower()
+        base_url = (getattr(agent, "base_url", "") or "").lower()
+        return provider == "deepseek" or "api.deepseek.com" in base_url
+
+    def _status_bar_balance(self) -> str:
+        """DeepSeek account balance (remaining, USD), cached ~5 min and fetched in a
+        background thread so the render loop never blocks. Returns "" when unavailable."""
+        if not self._status_bar_is_deepseek():
+            return ""
+        cache = getattr(self, "_status_bar_balance_cache", None)
+        now = time.monotonic()
+        if cache is not None and (now - cache[0]) < _BALANCE_TTL_SECONDS:
+            return cache[1]
+        if not getattr(self, "_status_bar_balance_fetching", False):
+            self._status_bar_balance_fetching = True
+            try:
+                threading.Thread(target=self._status_bar_balance_fetch, daemon=True).start()
+            except Exception:
+                self._status_bar_balance_fetching = False
+        return cache[1] if cache is not None else ""
+
+    def _status_bar_balance_fetch(self) -> None:
+        """Background fetch of the DeepSeek balance; never raises. Failure caches an empty
+        value too, so a dead network doesn't retry on every render (retries after the TTL)."""
+        value = ""
+        try:
+            agent = getattr(self, "agent", None)
+            key = getattr(agent, "api_key", "") if agent is not None else ""
+            value = self._status_bar_balance_usd(key) if isinstance(key, str) and key else ""
+        except Exception:
+            value = ""
+        finally:
+            try:
+                self._status_bar_balance_cache = (time.monotonic(), value)
+            finally:
+                self._status_bar_balance_fetching = False
+
+    def _status_bar_balance_usd(self, api_key: str) -> str:
+        """GET /user/balance for the key, returning a compact ``$X.XX`` label or ""."""
+        import json
+        import urllib.request
+        req = urllib.request.Request(
+            "https://api.deepseek.com/user/balance",
+            headers={"Authorization": "Bearer " + api_key, "Accept": "application/json"},
+        )
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            data = json.loads(resp.read().decode("utf-8"))
+        if not data.get("is_available"):
+            return ""
+        for info in data.get("balance_infos", []):
+            try:
+                total = float(info.get("total_balance", 0.0))
+            except (TypeError, ValueError):
+                continue
+            return f"${total:.2f}"
+        return ""
+
